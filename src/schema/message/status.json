{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/message/status.json",

  "type": "object",
  "properties": {
    "e": {
      "type": "integer",
      "minimum": 1
    },
    "t": {
      "type": "integer",
      "minimum": 1
    },
    "vrf": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "rp": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "e",
    "t",
    "vrf",
    "rp",
    "sig"
  ],
  "additionalProperties": false
}
