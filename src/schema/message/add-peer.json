{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/message/add-peer.json",

  "type": "object",
  "properties": {
    "http": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "udp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "pk": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "http",
    "udp",
    "pk"
  ],
  "additionalProperties": false
}
