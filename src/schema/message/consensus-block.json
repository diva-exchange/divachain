{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/message/consensus-block.json",

  "type": "object",
  "properties": {
    "e": {
      "type": "integer",
      "minimum": 1
    },
    "ha": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "p": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "cs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "validators.json" },
          { "$ref": "reputation.json" }
        ]
      },
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true
    }
  },
  "required": [
    "e",
    "ha",
    "p",
    "cs"
  ],
  "additionalProperties": false
}
