{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/message/checkpoint.json",
  "type": "object",
  "properties": {
    "c": {
      "type": "string",
      "pattern": "^checkpoint$"
    },
    "ns": {
      "type": "string",
      "pattern": "^sys:checkpoint$"
    },
    "d": {
      "type": "object",
      "properties": {
        "ah": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "b": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ah",
        "b"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "c",
    "ns",
    "d"
  ]
}
