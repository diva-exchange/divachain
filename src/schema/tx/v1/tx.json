{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/tx/v1/tx.json",

  "type": "object",
  "properties": {
    "v": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "h": {
      "type": "integer",
      "minimum": 1
    },
    "o": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "ha": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "p": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "cs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "data.json"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "v",
    "h",
    "o",
    "ha",
    "p",
    "cs"
  ],
  "additionalProperties": false
}
