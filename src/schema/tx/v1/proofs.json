{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "/schema/tx/v1/proofs.json",

  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "proof": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9+/]={0,3}$"
      },
      "sig": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{86}$"
      }
    },
    "required": [
      "origin",
      "sig"
    ],
    "additionalProperties": false
  },
  "minItems": 1,
  "uniqueItems": true
}
